// Cloudflare Workers deployment: `npm run build` → `npx wrangler deploy` uploads dist/ plus the leaderboard API
// worker (worker/index.ts, only runs for /api/*). Having this file stops wrangler from auto-configuring the Vite project.
{
  "name": "chanda-truck",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Leaderboard storage. Schema changes go in migrations/ and are applied with `npm run db:migrate`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chanda-truck",
      "database_id": "e20d946e-3399-4ccb-909f-426cc9b752ee",
      "migrations_dir": "migrations"
    }
  ]
}
